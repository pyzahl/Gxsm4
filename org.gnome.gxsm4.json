{
    "app-id" : "org.gnome.Gxsm4",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "41",
    "sdk" : "org.gnome.Sdk",
    "command" : "gxsm4",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
	"--socket=session-bus",
        "--socket=wayland",
        "--socket=fallback-x11",
	"--filesystem=host",
	"--socket=pulseaudio",
	"--device=all"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
      	"pypi-dependencies.json",
      	{
      	  "name": "other-modules"
      	},
        {
            "name" : "glm",
            "buildsystem" : "cmake",
            "sources" : [
                {
		    "type"   : "git",
		    "url"    : "https://github.com/g-truc/glm.git",
		    "branch" : "master"
                }
            ]
        },
        {
            "name" : "hdf5",
            "buildsystem" : "autotools",
            "sources" : [
                {
		    "type"   : "git",
		    "url"    : "https://github.com/HDFGroup/hdf5.git",
		    "branch" : "hdf5_1_12"
                }
            ]
        },
        {
            "name" : "netcdf",
            "buildsystem" : "cmake",
            "sources" : [
                {
		    "type"   : "git",
		    "url"    : "https://github.com/Unidata/netcdf-c.git",
		    "branch" : "main"
                }
            ]
        },
        {
            "name" : "netcdf-cxx4",
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type"   : "archive",
		    "url"    : "https://downloads.unidata.ucar.edu/netcdf-cxx/4.2/netcdf-cxx-4.2.tar.gz",
                    "sha256" : "95ed6ab49a0ee001255eac4e44aacb5ca4ea96ba850c08337a3e4c9a0872ccd1"
                }
            ]
        },
        {
            "name" : "gsl",
            "buildsystem" : "autotools",
            "sources" : [
                {
		    "type"   : "archive",
		    "url"    : "https://ftp.gnu.org/gnu/gsl/gsl-2.7.tar.gz",
		    "sha256" : "efbbf3785da0e53038be7907500628b466152dbc3c173a87de1b5eba2e23602b"
                }
            ]
        },
        {
            "name" : "gtksourceview",
            "buildsystem" : "meson",
            "sources" : [
                {
		    "type"   : "git",
		    "url"    : "https://gitlab.gnome.org/pyzahl/gtksourceview.git",
		    "branch" : "master"
                }
            ]
        },
        {
            "name" : "gxsm4",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type"   : "git",
                    "url"    : "https://github.com/pyzahl/Gxsm4.git",
		    "branch" : "master"
                }
            ]
        }
    ]
}
